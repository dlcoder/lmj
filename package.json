{
  "name": "lugares-miticos-de-jaen",
  "version": "1.0.0",
  "description": "Bilingual (Spanish/English) static website about mythical and legendary places in Jaen, Spain",
  "homepage": "https://www.lugaresmiticosdejaen.com/",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site .cache",
    "validate": "node scripts/validate-data.mjs",
    "check-links": "npm run build && node scripts/check-links.mjs",
    "check-pages": "npm run build && node scripts/check-pages.mjs",
    "build-icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.7"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
