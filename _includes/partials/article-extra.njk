{#- Closing block of a place article: summary, how to arrive, more articles
    and the share buttons, as the old site had it. -#}
{%- set t = i18n[locale].article -%}
{%- set articleUrl = siteUrl + "/" + locale + "/articles/" + article.slug -%}

<div class="article-extra">
  <div class="article-extra--wrapper">

    {%- if article.summary %}
    <section class="extra-block">
      <h2 class="extra-block--title">{{ t.summary }}</h2>
      <p>{{ article.summary }}</p>
    </section>
    {%- endif %}

    <section class="extra-block">
      <h2 class="extra-block--title">{{ t.howToArrive }}</h2>
      {%- if article.geolocation %}
      <div class="extra-map"
           id="article-map"
           data-latitude="{{ article.geolocation.latitude }}"
           data-longitude="{{ article.geolocation.longitude }}"></div>
      <a class="button"
         href="https://maps.google.com/maps?q={{ article.geolocation.latitude }},{{ article.geolocation.longitude }}&amp;ll={{ article.geolocation.latitude }},{{ article.geolocation.longitude }}&amp;z=10"
         rel="noopener">{{ t.viewLargerMap }}</a>
      {%- else %}
      <p class="extra-block--notice">{{ t.noGeolocation }}</p>
      {%- endif %}
    </section>

    {%- if article.relatedArticles | length %}
    <section class="extra-block">
      <h2 class="extra-block--title">{{ t.relatedArticles }}</h2>
      {%- set articles = article.relatedArticles -%}
      {%- set pagination = false -%}
      {% include "partials/article-grid.njk" %}
    </section>
    {%- endif %}

    <section class="extra-block">
      <h2 class="extra-block--title">{{ t.share }}</h2>
      <p>{{ t.shareHelp }}</p>
      <div class="extra-share">
        <a class="extra-share--link"
           href="https://x.com/intent/post?url={{ articleUrl | urlencode }}&amp;text={{ article.title | urlencode }}"
           rel="noopener">X</a>
        <a class="extra-share--link"
           href="https://www.facebook.com/sharer/sharer.php?u={{ articleUrl | urlencode }}"
           rel="noopener">Facebook</a>
      </div>
    </section>

  </div>
</div>
