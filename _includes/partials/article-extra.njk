{#- Closing block of a place article: every fact, how to arrive, the
    summary and four related articles, in that order at every width. -#}
{%- set t = i18n[locale].article -%}

<div class="article-extra">
  <div class="article-extra--wrapper">

    <section class="extra-block extra-meta">
      <h2 class="extra-block--title">{{ t.details }}</h2>
      {%- set full = true %}
      {% include "partials/article-meta.njk" %}
    </section>

    <section class="extra-block extra-arrive">
      <h2 class="extra-block--title">{{ t.howToArrive }}</h2>
      {%- if article.geolocation %}
      {#- Google's documented search URL takes no zoom and its map URL drops
          the pin; the place URL, the one Maps itself shares, does both. -#}
      <div class="extra-map--frame">
        <div class="extra-map"
             id="article-map"
             data-latitude="{{ article.geolocation.latitude }}"
             data-longitude="{{ article.geolocation.longitude }}"></div>
        <a class="button extra-map--expand"
           href="https://www.google.com/maps/place/{{ article.geolocation.latitude }},{{ article.geolocation.longitude }}/@{{ article.geolocation.latitude }},{{ article.geolocation.longitude }},14z"
           target="_blank"
           rel="noopener">{{ t.viewOnGoogleMaps }}</a>
      </div>
      {%- else %}
      <p class="extra-block--notice">{{ t.noGeolocation }}</p>
      {%- endif %}
    </section>

    {%- if article.summary %}
    <section class="extra-block extra-summary">
      <h2 class="extra-block--title">{{ t.summary }}</h2>
      <p{{ untranslated | safe }}>{{ article.summary }}</p>
    </section>
    {%- endif %}

    {%- if article.related | length %}
    {#- The whole pool is on the page, the closest four showing; the
        script swaps in today's four, seeded with the day and the id. -#}
    <section class="extra-block extra-related" id="related-articles" data-seed="{{ article.id }}">
      <h2 class="extra-block--title">{{ t.related }}</h2>
      <div class="article-grid">
        {%- for article in article.related %}
        {%- set eager = false %}
        {%- set hidden = loop.index > 4 %}
        {% include "partials/article-card.njk" %}
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

  </div>
</div>
