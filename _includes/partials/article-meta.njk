{#- The article's facts, each under a small label. The intro carries only
    the date and the municipality, as plain text; with `full` set, the
    closing block carries them all, linked. A place can sit in more than
    one municipality, and those in the same comarca list it once. -#}
{%- set labels = i18n[locale].article -%}
{%- set localities = article.enrichedLocalities -%}
{%- set regions = [] -%}
{%- set regionSlugs = [] -%}
{%- for loc in localities -%}
  {%- if loc.region and not (loc.region.slug in regionSlugs) -%}
    {%- set _ = regionSlugs.push(loc.region.slug) -%}
    {%- set _ = regions.push(loc.region) -%}
  {%- endif -%}
{%- endfor %}
<dl class="article-meta">
  {#- On the deck the title is many slides back, so the facts repeat it. -#}
  {%- if full %}
  <div class="article-meta--item">
    <dt>{{ labels.place }}</dt>
    <dd{{ untranslated | safe }}>{{ article.title }}</dd>
  </div>
  {%- endif %}
  <div class="article-meta--item">
    <dt>{{ labels.published }}</dt>
    <dd><time datetime="{{ article.published_at }}">{{ article.published_at | formatDate }}</time></dd>
  </div>
  {%- if localities.length > 0 %}
  <div class="article-meta--item">
    <dt>{{ labels.municipality if localities.length == 1 else labels.municipalities }}</dt>
    <dd>
      {%- for loc in localities -%}
        {%- if full %}<a href="/{{ locale }}/localities/{{ loc.slug }}">{{ loc.name }}</a>{% else %}{{ loc.name }}{% endif %}
        {%- if not loop.last %}, {% endif -%}
      {%- endfor -%}
    </dd>
  </div>
  {%- endif %}
  {%- if full and regions.length > 0 %}
  <div class="article-meta--item">
    <dt>{{ labels.region if regions.length == 1 else labels.regions }}</dt>
    <dd>
      {%- for region in regions -%}
        <a href="/{{ locale }}/regions/{{ region.slug }}">{{ region.name }}</a>
        {%- if not loop.last %}, {% endif -%}
      {%- endfor -%}
    </dd>
  </div>
  {%- endif %}
  {%- set categories = article.enrichedCategories %}
  {%- if full and categories.length > 0 %}
  <div class="article-meta--item">
    <dt>{{ labels.category if categories.length == 1 else labels.categories }}</dt>
    <dd>
      {%- for category in categories -%}
        <a href="/{{ locale }}/categories/{{ category.slug }}/">{{ category.name }}</a>
        {%- if not loop.last %}, {% endif -%}
      {%- endfor -%}
    </dd>
  </div>
  {%- endif %}
</dl>
