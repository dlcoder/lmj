{#- Tradition articles are long-form reading pages with their own layout,
    not the slide deck the place articles use. Their body already carries its
    own title and metadata. -#}
{% if article.body %}

<article class="article-tradition">
  {{ article.body | safe }}
</article>

{% else %}

<article class="article">
  <div class="slides--container">
    <div class="slides--slide">
      {%- set opening = article.galleryPhotos[0] -%}
      <div class="article-gallery" style="
        --intro-mobile: url('{% static_image opening.image_urls.mobile %}');
        --intro-tablet: url('{% static_image opening.image_urls.tablet %}');
        --intro-desktop: url('{% static_image opening.image_urls.desktop %}');
        --intro-desktop-hd: url('{% static_image opening.image_urls.desktop_hd %}');
      ">
        <div class="article-gallery--intro">
          <div class="article-header">
            <h1 class="article-title">{{ article.title }}</h1>
            {% include "partials/article-date.njk" %}
            {% include "partials/article-location.njk" %}
            {% include "partials/article-category.njk" %}
          </div>

          <div class="article-body">
            {% if article.body %}
              {{ article.body | safe }}
            {% else %}
            <ul>
              {%- for sentence in article.sentences -%}
                <li>{{ sentence }}</li>
              {%- endfor -%}
            </ul>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    {%- for media in article.galleryPhotos -%}
        <div class="slides--slide">
          <div class="article-gallery--media">
            <div class="responsive-image" role="img" style="
              --img-mobile: url('{% static_image media.image_urls.mobile %}');
              --img-tablet: url('{% static_image media.image_urls.tablet %}');
              --img-desktop: url('{% static_image media.image_urls.desktop %}');
              --img-desktop-hd: url('{% static_image media.image_urls.desktop_hd %}');
            "></div>
          </div>
        </div>
    {%- endfor -%}

    <div class="slides--slide slides--slide__extra">
      {% include "partials/article-extra.njk" %}
    </div>
  </div>

  <!-- Slide navigation dots (large screens only) -->
  <div class="slides-nav" id="slides-nav"></div>
</article>

{% endif %}
