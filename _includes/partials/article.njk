{#- Tradition articles are long-form reading pages with their own layout,
    not the slide deck the place articles use. Their body already carries its
    own title and metadata. -#}
{% if article.body %}

<article class="article-tradition">
  {{ article.body | safe }}
</article>

{% else %}

<article class="article">
  <div class="slides--container">
    <div class="slides--slide">
      <div class="article-gallery" style="
        --intro-mobile: url('{% static_image article.galleryPhotos[0].image_urls.mobile %}');
        --intro-tablet: url('{% static_image article.galleryPhotos[0].image_urls.tablet %}');
        --intro-desktop: url('{% static_image article.galleryPhotos[0].image_urls.desktop %}');
        --intro-desktop-hd: url('{% static_image article.galleryPhotos[0].image_urls.desktop_hd %}');
      ">
        <div class="article-gallery--intro">
          <div class="article-header">
            <h1 class="article-title">{{ article.title }}</h1>
            {% include "partials/article-date.njk" %}
            {% include "partials/article-location.njk" %}
            {% include "partials/article-category.njk" %}
          </div>

          <div class="article-body">
            {% if article.body %}
              {{ article.body | safe }}
            {% else %}
            <ul>
              {%- for sentence in article.sentences -%}
                <li>{{ sentence }}</li>
              {%- endfor -%}
            </ul>
            {% endif %}
          </div>

          {#- Only on the deck: below that width the photos are already in
              reading order and there is nothing to jump to. -#}
          <button type="button" class="button article-start" id="article-start">
            {{ i18n[locale].article.start }}
          </button>
        </div>
      </div>
    </div>

    {%- for media in article.galleryMedia -%}
        <div class="slides--slide">
          <div class="article-gallery--media">
            {%- if media.type == "Video" %}
            {#- Four articles carry a video, always a YouTube code. The
                no-cookie host keeps the cookie policy true, and the frame
                waits to be scrolled to like the photos do. -#}
            <iframe class="article-gallery--video"
                    src="https://www.youtube-nocookie.com/embed/{{ media.youtube_code }}"
                    title="{{ article.title }} (YouTube)"
                    loading="lazy"
                    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                    allowfullscreen
                    referrerpolicy="strict-origin-when-cross-origin"></iframe>
            {%- else %}
            {#- A gallery runs to eleven photos on the median article and
                twenty on the longest, and the deck shows one at a time, so
                they wait until they are scrolled to. Unlike the carousel's,
                these slides really are below the fold, so the browser's own
                lazy loading is enough. On the deck the photo is sized by
                its height — 90vh, letterboxed — which is what `sizes`
                describes there. -#}
            <img class="article-gallery--photo"
                 src="{% static_image media.image_urls.desktop %}"
                 srcset="{% static_image media.image_urls.mobile %} 480w,
                         {% static_image media.image_urls.tablet %} 640w,
                         {% static_image media.image_urls.desktop %} 1120w,
                         {% static_image media.image_urls.desktop_hd %} 1920w"
                 sizes="(min-width: 1280px) min(1920px, 135vh), 100vw"
                 width="1920" height="1278"
                 alt=""
                 loading="lazy"
                 decoding="async">
            {%- endif %}
          </div>
        </div>
    {%- endfor -%}

    <div class="slides--slide slides--slide__extra">
      {% include "partials/article-extra.njk" %}
      {% include "partials/footer.njk" %}
    </div>
  </div>

  <!-- Slide navigation dots (large screens only) -->
  <div class="slides-nav" id="slides-nav"></div>
</article>

{% endif %}
