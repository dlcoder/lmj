<article class="article">
  <div class="slides--container">
    <div class="slides--slide">
      <div class="article-gallery" style="
        --intro-mobile: url('{% featured_image article, "big_teaser_mobile" %}');
        --intro-tablet: url('{% featured_image article, "big_teaser_tablet" %}');
        --intro-desktop: url('{% featured_image article, "big_teaser_desktop" %}');
        --intro-desktop-hd: url('{% featured_image article, "big_teaser_desktop_hd" %}');
      ">
        <div class="article-gallery--intro">
          <div class="article-header">
            <h1 class="article-title">{{ article.title }}</h1>
            {% include "partials/article-date.njk" %}
            {% include "partials/article-location.njk" %}
            {% include "partials/article-category.njk" %}
          </div>

          <div class="article-body">
            {% if article.body %}
              {{ article.body | safe }}
            {% else %}
            <ul>
              {%- for sentence in article.sentences -%}
                <li>{{ sentence }}</li>
              {%- endfor -%}
            </ul>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    {%- if article.featuredPhoto -%}
      {#- The featured photo on its own, as it appears once the intro is out
          of the way, before the gallery starts. -#}
      <div class="slides--slide">
        <div class="article-gallery--media article-gallery--media__featured">
          <div class="responsive-image" role="img" style="
            --img-mobile: url('{% static_image article.featuredPhoto.image_urls.big_teaser_mobile %}');
            --img-tablet: url('{% static_image article.featuredPhoto.image_urls.big_teaser_tablet %}');
            --img-desktop: url('{% static_image article.featuredPhoto.image_urls.big_teaser_desktop %}');
            --img-desktop-hd: url('{% static_image article.featuredPhoto.image_urls.big_teaser_desktop_hd %}');
          "></div>
        </div>
      </div>
    {%- endif -%}

    {%- for media in article.media -%}
      {%- if media.type == "Photo" and media.featured == false and not article.body -%}
        <div class="slides--slide">
          <div class="article-gallery--media">
            <div class="responsive-image" role="img" style="
              --img-mobile: url('{% static_image media.image_urls.mobile %}');
              --img-tablet: url('{% static_image media.image_urls.tablet %}');
              --img-desktop: url('{% static_image media.image_urls.desktop %}');
              --img-desktop-hd: url('{% static_image media.image_urls.desktop_hd %}');
            "></div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <!-- Slide navigation dots (large screens only) -->
  <div class="slides-nav" id="slides-nav"></div>
</article>
