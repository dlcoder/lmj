{%- set t = i18n[locale].footer -%}
{%- set other = "en" if locale == "es" else "es" -%}
{%- set slugs = i18n[locale].pages -%}

<footer class="footer">
  <div class="footer-container">
    <nav class="footer-sitemap" aria-label="{{ t.project }}">
      <div class="footer-sitemap--column">
        <h2 class="footer-sitemap--title">{{ t.discover }}</h2>
        <ul class="footer-sitemap--list">
          {%- for category in categories_list[locale] %}
          <li><a href="/{{ locale }}/categories/{{ category.slug }}/">{{ category.name }}</a></li>
          {%- endfor %}
          <li><a href="/{{ locale }}/articles/">{{ t.allArticles }}</a></li>
          <li><a href="/{{ locale }}/localities/">{{ t.localities }}</a></li>
          <li><a href="/{{ locale }}/localities/map/">{{ t.map }}</a></li>
        </ul>
      </div>

      <div class="footer-sitemap--column">
        <h2 class="footer-sitemap--title">{{ t.regions }}</h2>
        <ul class="footer-sitemap--list">
          {%- for region in regions_list %}
          <li><a href="/{{ locale }}/regions/{{ region.slug }}/">{{ region.name }}</a></li>
          {%- endfor %}
          <li><a href="/{{ locale }}/regions/">{{ t.allRegions }}</a></li>
        </ul>
      </div>

      <div class="footer-sitemap--column">
        <h2 class="footer-sitemap--title">{{ t.project }}</h2>
        <ul class="footer-sitemap--list">
          <li><a href="/{{ locale }}/">{{ i18n[locale].nav.home }}</a></li>
          <li><a href="/{{ locale }}/{{ slugs.project }}">{{ i18n[locale].nav.project }}</a></li>
          <li><a href="/{{ locale }}/{{ slugs.books }}">{{ i18n[locale].nav.books }}</a></li>
          <li><a href="/{{ locale }}/{{ slugs.book1 }}">{{ i18n[locale].home.firstBook }}</a></li>
          <li><a href="/{{ locale }}/{{ slugs.book2 }}">{{ i18n[locale].home.secondBook }}</a></li>
        </ul>
      </div>
    </nav>

    <div class="footer-colophon">
      <ul class="footer-languages" aria-label="{{ t.language }}">
        <li class="footer-languages--item footer-languages--item__current">
          <span>{{ "Español" if locale == "es" else "English" }}</span>
        </li>
        <li class="footer-languages--item">
          <a href="/{{ other }}/">{{ "English" if locale == "es" else "Español" }}</a>
        </li>
      </ul>

      <ul class="footer-social" aria-label="{{ t.social }}">
        <li>
          <a href="https://www.facebook.com/LugaresMiticos" rel="noopener" title="Facebook ({{ t.socialNote }})">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7H7.9v-2.9h2.54V9.85c0-2.52 1.5-3.91 3.77-3.91 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.9h-2.33v7A10.02 10.02 0 0 0 22 12.06Z"/></svg>
            <span class="footer-social--name">Facebook</span>
          </a>
        </li>
        <li>
          <a href="https://www.instagram.com/lugaresmiticos" rel="noopener" title="Instagram ({{ t.socialNote }})">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.8 3.8 0 0 1-1.38-.9 3.8 3.8 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.98c-3.14 0-3.51.01-4.75.07-1.15.05-1.77.24-2.18.4-.55.22-.94.47-1.35.88-.41.41-.66.8-.88 1.35-.16.41-.35 1.03-.4 2.18-.06 1.24-.07 1.61-.07 4.75s.01 3.51.07 4.75c.05 1.15.24 1.77.4 2.18.22.55.47.94.88 1.35.41.41.8.66 1.35.88.41.16 1.03.35 2.18.4 1.24.06 1.61.07 4.75.07s3.51-.01 4.75-.07c1.15-.05 1.77-.24 2.18-.4.55-.22.94-.47 1.35-.88.41-.41.66-.8.88-1.35.16-.41.35-1.03.4-2.18.06-1.24.07-1.61.07-4.75s-.01-3.51-.07-4.75c-.05-1.15-.24-1.77-.4-2.18a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.41-.16-1.03-.35-2.18-.4-1.24-.06-1.61-.07-4.75-.07Zm0 3.37a6.49 6.49 0 1 1 0 12.98 6.49 6.49 0 0 1 0-12.98Zm0 10.7a4.21 4.21 0 1 0 0-8.42 4.21 4.21 0 0 0 0 8.42Zm8.26-10.96a1.52 1.52 0 1 1-3.03 0 1.52 1.52 0 0 1 3.03 0Z"/></svg>
            <span class="footer-social--name">Instagram</span>
          </a>
        </li>
        <li>
          <a href="https://x.com/lugaresmiticos" rel="noopener" title="X ({{ t.socialNote }})">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18.9 2.5h3.33l-7.27 8.31L23.5 21.5h-6.7l-5.25-6.86-6 6.86H1.72l7.78-8.89L.9 2.5h6.87l4.74 6.27L18.9 2.5Zm-1.17 17h1.84L7.35 4.4H5.38l12.35 15.1Z"/></svg>
            <span class="footer-social--name">X</span>
          </a>
        </li>
        <li>
          <a class="footer-social--email" href="mailto:participa@lugaresmiticosdejaen.com" title="{{ t.writeToUs }}">participa@lugaresmiticosdejaen.com</a>
        </li>
      </ul>

      <div class="footer-credits">
        <p class="footer-credits--byline">
          {{ t.credits }}
          <a href="https://www.deliriumcoder.com" rel="noopener">Delirium Coder</a>
          {{ "and" if locale == "en" else "y" }}
          <a href="http://www.studiojosetorres.com/" rel="noopener">Studio José Torres</a>
        </p>
        <ul class="footer-credits--legal">
          <li><a href="/{{ locale }}/{{ slugs.cookies }}">{{ t.cookies }}</a></li>
          <li><a href="/{{ locale }}/{{ slugs.copyright }}">{{ t.copyright }}</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
