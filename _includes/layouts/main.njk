<!DOCTYPE html>
<html lang="{{ locale or "es" }}">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {#- The maps fetch the municipality outlines from here. Published once so
      that STATICS_HOST reaches the browser scripts too, instead of each of
      them carrying the host written in by hand. -#}
  <meta name="statics-host" content="{{ staticsHost }}">
  <title>{{ title }}</title>
  {#- Drawn from img/favicon.svg; `npm run build-icons` renders the rest. -#}
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#423780">
  {#- The page as search engines and link previews should know it. The
      domain is whatever CNAME publishes the site under, and the translation
      is paired by alternateFor() in _data/base.js. An English article that
      still carries the Spanish text is the same page but not a translation,
      so it gets no hreflang pair. -#}
  {%- set url = siteUrl + (page.url | cleanUrl) %}
  {%- set alternate = page.url | alternate %}
  {%- set description = (article.summary or (article.sentences | join(" ")) if article else pageDescription) or i18n[locale].siteDescription %}
  <meta name="description" content="{{ description | excerpt }}">
  {%- if noIndex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ url }}">
  {%- endif %}
  {%- if alternate and alternate.translated %}
  <link rel="alternate" hreflang="{{ locale }}" href="{{ url }}">
  <link rel="alternate" hreflang="{{ "en" if locale == "es" else "es" }}" href="{{ siteUrl }}{{ alternate.path }}">
  {%- if page.url == "/" + locale + "/" %}
  {#- The root picks the language for whoever has not chosen one yet. -#}
  <link rel="alternate" hreflang="x-default" href="{{ siteUrl }}/">
  {%- endif %}
  {%- endif %}
  <meta property="og:site_name" content="{{ i18n[locale].siteTitle }}">
  <meta property="og:locale" content="{{ "es_ES" if locale == "es" else "en_GB" }}">
  <meta property="og:url" content="{{ url }}">
  <meta property="og:title" content="{{ article.title if article else title }}">
  <meta property="og:description" content="{{ description | excerpt(200) }}">
  {%- if article %}
  <meta property="og:type" content="article">
  <meta property="article:published_time" content="{{ article.published_at }}">
  {%- set ogImage %}{% featured_image article, 'facebook' %}{% endset %}
  {%- if ogImage %}
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  {%- endif %}
  {%- else %}
  <meta property="og:type" content="website">
  {%- endif %}
  {#- Structured data: the article, and the place it is about, with its
      coordinates where they are published. -#}
  {%- if article %}
  {%- set structured = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": article.title,
    "datePublished": article.published_at,
    "inLanguage": "es" if (locale == "en" and not article.translated) else locale,
    "url": url,
    "image": ogImage,
    "publisher": { "@type": "Organization", "name": i18n[locale].siteTitle, "url": siteUrl + "/" + locale + "/" },
    "about": {
      "@type": "TouristAttraction",
      "name": article.title,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": article.localities | join(", "),
        "addressRegion": "Jaén",
        "addressCountry": "ES"
      }
    }
  } %}
  {%- if article.geolocation %}
  {%- set structured = structured | setGeo(article.geolocation) %}
  {%- endif %}
  <script type="application/ld+json">{{ structured | dump | safe }}</script>
  {%- elif page.url == "/" + locale + "/" %}
  <script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "WebSite", "name": i18n[locale].siteTitle, "url": url, "inLanguage": locale } | dump | safe }}</script>
  {%- endif %}
  {#- Leaflet and its cluster plugin are served from this site, copied out of
      node_modules at build time, so the maps depend on no third party. The
      files are byte for byte the ones unpkg served before. Deferred like
      the map scripts that use them, which come later in the head and so run
      after them. -#}
  {%- if includeLeaflet -%}
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css?v={{ vendor.leaflet }}">
  <script src="/vendor/leaflet/leaflet.js?v={{ vendor.leaflet }}" defer></script>
  {%- endif -%}
  {#- Only the maps that plot articles need the clusters: 43 of them land on
      Jaén alone, most inside the old town. It is what the original used. -#}
  {%- if includeMarkerCluster -%}
  <link rel="stylesheet" href="/vendor/leaflet.markercluster/MarkerCluster.css?v={{ vendor.markercluster }}">
  <link rel="stylesheet" href="/vendor/leaflet.markercluster/MarkerCluster.Default.css?v={{ vendor.markercluster }}">
  <script src="/vendor/leaflet.markercluster/leaflet.markercluster.js?v={{ vendor.markercluster }}" defer></script>
  {%- endif -%}
  {#- The body text and the headings, so they do not wait for the stylesheet. #}
  <link rel="preload" href="/vendor/fonts/merriweather-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/vendor/fonts/lato-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/styles.css?v={{ timestamp }}">
  <script src="/js/hamburger-menu.js?v={{ timestamp }}" defer></script>
  <script src="/js/header-menu.js?v={{ timestamp }}" defer></script>
  <script src="/js/article-slides.js?v={{ timestamp }}" defer></script>
  {%- if includeLocalitiesMap -%}
  <script src="/js/localities-map.js?v={{ timestamp }}" defer></script>
  {%- endif -%}
  {%- if includeLatestArticles -%}
  <script src="/js/latest-articles.js?v={{ timestamp }}" defer></script>
  {%- endif -%}
  {%- if includeSearch -%}
  <script src="/js/home-search.js?v={{ timestamp }}" defer></script>
  {%- endif -%}
  {%- if includeLocalityMap -%}
  <script src="/js/locality-map.js?v={{ timestamp }}" defer></script>
  {%- endif -%}
  {%- if includeExplorerMap -%}
  <script src="/js/explorer-map.js?v={{ timestamp }}" defer></script>
  {%- endif -%}
  {%- if includeArticleMap -%}
  <script src="/js/article-map.js?v={{ timestamp }}" defer></script>
  {%- endif -%}
  {%- if article.type == 'Place' and article.related | length > 4 -%}
  <script src="/js/related-articles.js?v={{ timestamp }}" defer></script>
  {%- endif -%}
</head>

<body class="{% if bodyClass %}{{ bodyClass }}{% endif %}">
  <div id="header" class="header">
    <div class="header-container">
      <div class="header-logo">
        <h1 class="header-logo--title">
          <a href="/{{ locale }}/">
            {#- The pin from the original header, redrawn: the asset there was
                a 38x50 PNG that went soft on any dense screen. The geometry is
                fitted to that file's alpha mask, not eyeballed — ring, gap and
                inner disc all land within a pixel of it. -#}
            <svg class="header-logo--mark" viewBox="0 0 38 50" aria-hidden="true" focusable="false">
              <path fill="currentColor" fill-rule="evenodd"
                    d="M4.109 49.162L0.453 20.871A18.5 18.5 0 1 1 28.448 34.285ZM18.8 3.95a14.55 14.55 0 1 0 0 29.1a14.55 14.55 0 1 0 0-29.1ZM18.8 9.25a9.25 9.25 0 1 0 0 18.5a9.25 9.25 0 1 0 0-18.5Z"/>
            </svg>
            <span>{{ i18n[locale].siteTitle }}</span>
          </a>
        </h1>
      </div>
      <button class="header-hamburger" id="hamburger-menu" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="header-nav" id="header-nav">
        <a href="/{{ locale }}/">{{ i18n[locale].nav.home }}</a>
        {#- The site map of the original's header: categories and the ways
            into the archive. It opens on hover and focus from the CSS alone,
            so it works without the script; the script adds the click, the
            Escape key and the accordion inside the mobile menu. -#}
        {%- set menu = i18n[locale].menu %}
        <div class="header-nav--item header-nav--item__expands">
          <button type="button" class="header-nav--toggle" aria-expanded="false" aria-controls="header-menu-discover">{{ menu.discover }}</button>
          <div class="header-menu" id="header-menu-discover">
            <div class="header-menu--wrapper">
              <p class="header-menu--slogan">{{ menu.discoverSlogan }}</p>
              <div class="header-menu--column header-menu--column__categories">
                <h2 class="header-menu--title">{{ menu.categories }}</h2>
                <ul>
                  {%- for category in categories_list[locale] %}
                  <li><a href="/{{ locale }}/categories/{{ category.slug }}/">{{ category.name }}</a></li>
                  {%- endfor %}
                </ul>
              </div>
              <div class="header-menu--column">
                <h2 class="header-menu--title">{{ menu.archive }}</h2>
                <ul>
                  <li><a href="/{{ locale }}/articles/">{{ i18n[locale].footer.allArticles }}</a></li>
                  <li><a href="/{{ locale }}/localities/">{{ i18n[locale].footer.localities }}</a></li>
                  <li><a href="/{{ locale }}/regions/">{{ menu.regions }}</a></li>
                  <li><a href="/{{ locale }}/localities/map/">{{ i18n[locale].footer.map }}</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <a href="/{{ locale }}/{{ i18n[locale].pages.project }}">{{ i18n[locale].nav.project }}</a>
        <a href="/{{ locale }}/{{ i18n[locale].pages.books }}">{{ i18n[locale].nav.books }}</a>
      </nav>
    </div>
  </div>

  <div class="main-container">
    {{ content | safe }}
  </div>

  {#- Place articles carry the footer inside their last slide, because the
      deck takes over scrolling and anything after it cannot be reached. -#}
  {%- if not article or article.body %}
  {% include "partials/footer.njk" %}
  {%- endif %}
</body>

</html>
