---
layout: layouts/main.njk
# One page per locale: the keys of i18n are the locales.
pagination:
  data: i18n
  size: 1
  addAllPagesToCollections: true
  alias: pageLocale
eleventyComputed:
  title: "{{ i18n[pageLocale].localities.title }} – {{ i18n[pageLocale].site.title }}"
  permalink: "{{ pageLocale }}/localities/index.html"
  locale: "{{ pageLocale }}"
includeLeaflet: true
includeLocalitiesMap: true
bodyClass: "locality-page"
---

{#- As in the original: the list over the map, as on the home page, under a
    lead. The map is the home one too — the province, and the outline of
    whichever municipality the pointer is on — only framing the whole
    province, since the list here is taller. -#}
<div class="locality-wrapper">
  <div class="page-header">
    <h1 class="page-title">{{ i18n[locale].localities.title }}</h1>
  </div>
</div>

<div class="localities-section">
  <div class="localities-container">
    <p class="page-lead localities-lead">{{ i18n[locale].localities.lead }}</p>
    {% include "partials/localities-list.njk" %}
  </div>

  <div class="localities-map-container">
    <div id="localities-map" class="localities-map" data-fit-province></div>
  </div>
</div>
