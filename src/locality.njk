---
layout: layouts/main.njk
pagination:
  data: all_pages.all_localities
  size: 1
  addAllPagesToCollections: true
  alias: localityPage
eleventyComputed:
  title: "{{ localityPage.locality.name }} – {{ i18n[localityPage.locale].siteTitle }}"
  permalink: "{{ localityPage.locale }}/localities/{{ localityPage.locality.slug }}{% if localityPage.pagination.pageNumber > 0 %}/page/{{ localityPage.pagination.pageNumber + 1 }}{% endif %}/"
  locale: "{{ localityPage.locality.locale if localityPage.locality.locale else localityPage.locale }}"
includeLeaflet: true
includeLocalityMap: true
includeMarkerCluster: true
bodyClass: "locality-page"
---

<div class="locality-wrapper">
  <div class="page-header">
    <h1 class="page-title">{{ localityPage.locality.name }}</h1>
    <p class="page-title--context">
      <a href="/{{ locale }}/regions/{{ localityPage.locality.region.slug }}/">{{ localityPage.locality.region.name }}</a>
    </p>
  </div>
</div>

{#- The map runs the full width of the page, between the name and the grid,
    as in the original: there it sat outside the wrapper, in
    before_main_content. -#}
<div class="locality-map" id="locality-map"
     data-locality-id="{{ localityPage.locality.id }}"
     data-locale="{{ localityPage.locale }}"></div>

<div class="locality-wrapper">
  {% set articles = localityPage.articles %}
  {% set pagination = localityPage.pagination %}
  {% include "partials/article-grid.njk" %}
</div>
