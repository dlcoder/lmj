---
layout: layouts/main.njk
pagination:
  data: all_pages.all_home_pages
  size: 1
  alias: indexPage
eleventyComputed:
  title: "{{ i18n[indexPage.locale].siteTitle }}"
  permalink: "{{ indexPage.locale }}/index.html"
  locale: "{{ indexPage.locale }}"
bodyClass: "home-page"
includeLeaflet: true
includeLocalitiesMap: true
includeLatestArticles: true
---

{%- set latestArticles = indexPage.articles.slice(0, 5) -%}
{% include "partials/latest-articles.njk" %}


<div class="categories-section">
  <h2 class="categories-section-title">{{ i18n[indexPage.locale].home.discover }}</h2>

  <div class="article-grid">
    {%- for category in categories_list[indexPage.locale] -%}
      <article class="article-card">
        <a href="/{{ locale }}/categories/{{ category.slug }}" class="article-card--link">
          {#- One file per category, no variants to choose from. Empty alt
              because the name is right below, in the heading. -#}
          <img class="article-card--image"
               src="{% static_image '/files/categories/' + category.imageSlug + '.jpg' %}"
               width="640" height="480"
               alt=""
               loading="lazy"
               decoding="async">
          <div class="article-card--content">
            <h2 class="article-card--title">{{ category.name }}</h2>
          </div>
        </a>
      </article>
    {%- endfor -%}
  </div>
</div>

<div class="localities-section">
  <h2 class="localities-title">{{ i18n[indexPage.locale].home.exploreLocalities }}</h2>

  <div class="localities-container">
    <ul class="localities-list">
      {%- for locality in localities_list -%}
        <li class="locality-item">
          {#- Half the municipalities have no article, so they have no page to
              link to. They still belong on the list and still light up on the
              map, so they stay as plain text. -#}
          {%- if locality.articleCount %}
          <a href="/{{ locale }}/localities/{{ locality.slug }}"
             class="locality-link"
             data-locality-id="{{ locality.id }}">{{ locality.name }} ({{ locality.articleCount }})</a>
          {%- else %}
          <span class="locality-link"
                data-locality-id="{{ locality.id }}">{{ locality.name }}</span>
          {%- endif %}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="localities-map-container">
    <div id="localities-map" class="localities-map"></div>
  </div>
</div>

{% include "partials/home-books.njk" %}
