---
layout: layouts/main.njk
pagination:
  data: all_pages.all_home_pages
  size: 1
  addAllPagesToCollections: true
  alias: indexPage
eleventyComputed:
  title: "{{ i18n[indexPage.locale].site.title }}"
  permalink: "{{ indexPage.locale }}/index.html"
  locale: "{{ indexPage.locale }}"
bodyClass: "home-page"
includeLeaflet: true
includeLocalitiesMap: true
includeLatestArticles: true
includeSearch: true
---

{%- set latestArticles = indexPage.articles.slice(0, 5) -%}
{% include "partials/latest-articles.njk" %}


<div class="categories-section">
  <div class="categories-section--head">
    <h2 class="categories-section-title">{{ i18n[indexPage.locale].home.discover }}</h2>

    {#- The search lives here, under the heading, and its results take the
        place of the category tiles while there is a query. It needs the
        script, so the form stays hidden until the script shows it. -#}
    {%- set search = i18n[locale].search %}
    <form class="home-search" id="home-search" role="search" hidden
          data-locale="{{ locale }}"
          data-one="{{ search.countOne }}" data-many="{{ search.countMany }}" data-none="{{ search.countNone }}">
      <label class="visually-hidden" for="home-search-input">{{ search.label }}</label>
      <input class="home-search--input" id="home-search-input" type="search" name="q"
             placeholder="{{ search.placeholder }}" autocomplete="off" spellcheck="false">
    </form>
    <p class="home-search--status" id="home-search-status" role="status"></p>
  </div>

  <div class="article-grid home-search--results" id="home-search-results" hidden></div>

  <div class="article-grid" id="home-categories">
    {%- for category in categories_list[indexPage.locale] -%}
      <article class="article-card">
        <a href="/{{ locale }}/categories/{{ category.slug }}" class="article-card--link">
          {#- One file per category, no variants to choose from. Empty alt
              because the name is over it, in the heading. -#}
          <img class="article-card--image"
               src="{% static_image '/files/categories/' + category.imageSlug + '.jpg' %}"
               width="640" height="480"
               alt=""
               loading="lazy"
               decoding="async">
          <div class="article-card--content">
            <span class="category-tile--index">{{ ("0" + loop.index) if loop.index < 10 else loop.index }}</span>
            <h2 class="article-card--title">{{ category.name }}</h2>
            <span class="category-tile--count">{{ category.articleCount }} {{ i18n[indexPage.locale].home.categoryArticles }}</span>
          </div>
        </a>
      </article>
    {%- endfor -%}
  </div>
</div>

<div class="localities-section">
  <h2 class="localities-title">{{ i18n[indexPage.locale].home.exploreLocalities }}</h2>

  <div class="localities-container">
    {% include "partials/localities-list.njk" %}
  </div>

  <div class="localities-map-container">
    <div id="localities-map" class="localities-map"></div>
  </div>
</div>

{% include "partials/home-books.njk" %}
