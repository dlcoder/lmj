---
layout: layouts/main.njk
pagination:
  data: all_pages.all_regions
  size: 1
  addAllPagesToCollections: true
  alias: regionPage
eleventyComputed:
  title: "{{ regionPage.region.name }} – {{ i18n[regionPage.locale].site.title }}"
  permalink: "{{ regionPage.locale }}/regions/{{ regionPage.region.slug }}{% if regionPage.pagination.pageNumber > 0 %}/page/{{ regionPage.pagination.pageNumber + 1 }}{% endif %}/"
  locale: "{{ regionPage.locale }}"
---

<div class="page-header">
  <h1 class="page-title">{{ regionPage.region.name }}</h1>
</div>

{% set articles = regionPage.articles %}
{% set pagination = regionPage.pagination %}
{% include "partials/article-grid.njk" %}
