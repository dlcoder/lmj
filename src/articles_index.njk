---
# The geolocated-articles index, one file per locale. No layout: the output is
# the JSON itself, read with fetch() by the maps and the search.
pagination:
  data: articles_index
  size: 1
  alias: indexLocale
eleventyComputed:
  permalink: "{{ indexLocale }}/articles.json"
---
{{- articles_index[indexLocale] | dump | safe -}}
