---
layout: layouts/main.njk
pagination:
  data: all_pages.all_categories
  size: 1
  addAllPagesToCollections: true
  alias: categoryPage
eleventyComputed:
  title: "{{ categoryPage.category.name }} – {{ i18n[categoryPage.locale].site.title }}"
  permalink: "{{ categoryPage.locale }}/categories/{{ categoryPage.category.slug }}{% if categoryPage.pagination.pageNumber > 0 %}/page/{{ categoryPage.pagination.pageNumber + 1 }}{% endif %}/"
  locale: "{{ categoryPage.locale }}"
---

<div class="page-header">
  <h1 class="page-title">{{ categoryPage.category.name }}</h1>
</div>

{% set articles = categoryPage.articles %}
{% set pagination = categoryPage.pagination %}
{% include "partials/article-grid.njk" %}
